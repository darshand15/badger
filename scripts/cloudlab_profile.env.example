# Copy this file to scripts/cloudlab_profile.env and edit for each new CloudLab experiment.

# SSH user on all CloudLab nodes.
CLOUDLAB_USER=ashluo

# Optional label for logs and artifacts.
EXPERIMENT_NAME=ashluo-XXXXXX

# Node hostnames (direct pcNNN hostnames are usually most reliable).
PC_CLIENT=pc000.emulab.net
PC_DIRECTORY=pc000.emulab.net
PC_MONITORING=pc000.emulab.net

# Comma-separated lists.
PC_BROKERS=pc000.emulab.net,pc000.emulab.net
PC_SERVERS=pc000.emulab.net,pc000.emulab.net,pc000.emulab.net

# lock-free-machine runtime knobs.
NUM_BROKER=2
NUM_SERVER=3
DROP_RATE=0
IS_TEST=false
USE_BENCHMARK=true
USE_DUCKDB=true
EXECUTOR=1
NUM_TXNS=200
NUM_PACKAGES=20000
MAX_EPOCHS=20000

# BenchBase knobs.
BENCHBASE_DURATION_SEC=300
BENCHBASE_TERMINALS=16
BENCHBASE_RATE=4000

# Paths for the three local repositories.
REPO_BADGER=/Users/AshleyLuo1/GolandProjects/darshan-badger
REPO_LOCKFREE=/Users/AshleyLuo1/GolandProjects/lock-free-machine
REPO_BENCHBASE=/Users/AshleyLuo1/GolandProjects/benchbase-sqlite
